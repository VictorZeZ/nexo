{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Redis": {
    "ConnectionString": ""
  },
  "ProtocolLimits": {
    "MaxRoomIdLength": 64,
    "MaxRoomNameLength": 64,
    "MaxDisplayNameLength": 32,
    "MaxPasswordLength": 128,
    "MaxCiphertextLength": 8000,
    "MaxNonceLength": 64,
    "MaxParticipantIdLength": 64,
    "MaxReconnectTokenLength": 128
  },
  "WebSocketConnection": {
    "MaxMessageSizeBytes": 16384,
    "SendQueueCapacity": 64,
    "KeepAliveIntervalSeconds": 30
  },
  "Rooms": {
    "DefaultMaxParticipants": 50,
    "TimeToLiveMinutes": 60,
    "MaxHistoryMessages": 200,
    "ReconnectGracePeriodSeconds": 1800
  },
  "Heartbeat": {
    "SweepIntervalSeconds": 20,
    "StaleAfterSeconds": 45
  }
}